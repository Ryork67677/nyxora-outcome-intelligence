DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
DATA_DIR=./data

# Embeddings: openai | local (sentence-transformers) | local-lsa (offline TF-IDF+SVD)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=unversioned

# Only for EMBEDDING_PROVIDER=local-lsa. The fit corpus is part of the model's
# identity, so query and chunk vectors cannot come from different fits.
# LSA_FIT_SNAPSHOT_ID=snap_...
# LSA_DIMENSION=384

# Generation for EXP-NULL and answer command
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-5.6
OPENAI_API_KEY=

# Chunking
MAX_CHUNK_CHARS=3500
MIN_CHUNK_CHARS=200
