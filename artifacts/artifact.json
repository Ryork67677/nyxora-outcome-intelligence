    "generatedAt": "2026-07-15T03:46:26.982499+00:00",
    "sources": [
      {
        "id": "source_summary",
        "label": "Synthetic portfolio overview and model summary",
        "query": {
          "sql": "SELECT\n            COUNT(*)::INTEGER AS matured_leads,\n            SUM(booked)::INTEGER AS booked_leads,\n            ROUND(AVG(booked), 6) AS booking_rate,\n            ROUND(MEDIAN(response_minutes), 2) AS median_response_minutes,\n            (SELECT test_roc_auc FROM mart_model_summary) AS test_roc_auc,\n            (SELECT COUNT(*)::INTEGER FROM mart_scored_candidates) AS open_candidates,\n            (SELECT MAX(psi) FROM mart_feature_drift) AS maximum_psi\n        FROM fct_lead_outcomes\n        WHERE is_matured",
          "description": "Synthetic portfolio overview and model summary",
          "engine": "DuckDB",
          "language": "sql",
          "executed_at": "2026-07-15T03:46:26.982499+00:00",
          "tables_used": [
            "fct_lead_outcomes",
            "mart_model_summary",
            "mart_scored_candidates",
            "mart_feature_drift"
          ],
          "filters": [
            "is_matured = true"
          ],
          "metric_definitions": [
            "Matured leads: leads created at least 14 days before the synthetic as-of timestamp.",
            "Booking rate: matured leads with a consultation_booked event divided by matured leads.",
            "Median response: median minutes to first contact inside the 24-hour observation window; 1,440 represents no contact.",
            "Test ROC AUC: discrimination on the newest chronological 15% holdout set.",
            "Open candidates: unbooked leads created in the latest 14 days with a completed 24-hour observation window."
          ]
        }
      },
      {
        "id": "source_monthly",
        "label": "Monthly matured-lead funnel",
        "query": {
          "sql": "SELECT * FROM mart_monthly_funnel ORDER BY month",
          "description": "Monthly matured-lead funnel",
          "engine": "DuckDB",
          "language": "sql",
          "executed_at": "2026-07-15T03:46:26.982499+00:00",
          "tables_used": [
            "mart_monthly_funnel"
          ],
          "filters": [],
          "metric_definitions": [
            "Monthly booking rate: booked matured leads divided by matured leads created in the month.",
            "Only fully observed leads are included; timestamps use UTC."
          ]
        }
      },
      {
        "id": "source_channels",
        "label": "Acquisition channel performance",
        "query": {
          "sql": "SELECT * FROM mart_channel_performance ORDER BY booking_rate DESC",
          "description": "Acquisition channel performance",
          "engine": "DuckDB",
          "language": "sql",
          "executed_at": "2026-07-15T03:46:26.982499+00:00",
          "tables_used": [
