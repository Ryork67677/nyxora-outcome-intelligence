        "executed_at": "2026-07-15T03:46:26.982499+00:00",
        "tables_used": [
          "mart_campaign_performance"
        ],
        "filters": [
          "minimum 50 matured leads",
          "top 10 by booking rate"
        ],
        "metric_definitions": [
          "Channel booking rate: booked matured leads divided by matured leads for the acquisition channel.",
          "Pipeline value: sum of synthetic estimated lead value, not realized revenue."
        ]
      }
    },
    {
      "id": "source_calibration",
      "label": "Chronological holdout calibration",
      "query": {
        "sql": "SELECT * FROM mart_model_calibration ORDER BY decile",
        "description": "Chronological holdout calibration",
        "engine": "DuckDB",
        "language": "sql",
        "executed_at": "2026-07-15T03:46:26.982499+00:00",
        "tables_used": [
          "mart_model_calibration"
        ],
        "filters": [],
        "metric_definitions": [
          "Predictions are grouped into equal-frequency deciles on the chronological holdout set.",
          "Observed booking rate is the booked share within each decile."
        ]
      }
    },
    {
      "id": "source_importance",
      "label": "Holdout permutation importance",
      "query": {
        "sql": "SELECT * FROM mart_feature_importance ORDER BY importance_mean DESC LIMIT 8",
        "description": "Holdout permutation importance",
        "engine": "DuckDB",
        "language": "sql",
        "executed_at": "2026-07-15T03:46:26.982499+00:00",
        "tables_used": [
          "mart_feature_importance"
        ],
        "filters": [
          "top 8 features by mean importance"
        ],
        "metric_definitions": [
          "Permutation importance: mean change in holdout ROC AUC after shuffling one input feature.",
          "Importance describes predictive association, not causality."
        ]
      }
    },
    {
      "id": "source_drift",
      "label": "Feature distribution monitoring",
      "query": {
        "sql": "SELECT * FROM mart_feature_drift ORDER BY psi DESC",
        "description": "Feature distribution monitoring",
        "engine": "DuckDB",
        "language": "sql",
        "executed_at": "2026-07-15T03:46:26.982499+00:00",
        "tables_used": [
          "mart_feature_drift"
        ],
        "filters": [],
        "metric_definitions": [
          "Population Stability Index compares the oldest 70% reference period with the newest 30% comparison period.",
          "PSI below 0.10 is stable, 0.10-0.20 is watch, and 0.20 or above requires review."
        ]
      }
    },
    {
      "id": "source_candidates",
      "label": "Highest-priority open synthetic leads",
      "query": {
        "sql": "SELECT\n            lead_id,\n            channel,\n            service_type,\n            ROUND(booking_probability, 4) AS booking_probability,\n            ROUND(priority_score, 2) AS priority_score,\n            recommended_action,\n            ROUND(response_minutes, 1) AS response_minutes,\n            ROUND(estimated_value, 2) AS estimated_value\n        FROM mart_scored_candidates\n        ORDER BY priority_score DESC\n        LIMIT 12",
        "description": "Highest-priority open synthetic leads",
        "engine": "DuckDB",
        "language": "sql",
        "executed_at": "2026-07-15T03:46:26.982499+00:00",
        "tables_used": [
          "mart_scored_candidates"
        ],
        "filters": [
          "top 12 by priority score"
        ],
        "metric_definitions": [
          "Priority score: predicted booking probability \u00d7 estimated value \u00d7 a 1.2 delayed-response multiplier when response is at least 120 minutes.",
          "Candidates exclude already-booked leads and leads without a completed 24-hour observation window."
        ]
      }
    }
